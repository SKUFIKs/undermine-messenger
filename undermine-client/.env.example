# UnderMine Client Configuration

# Backend API URL (Go server or Node relay). Both must be reachable from the browser.
# All API calls and WebSocket connections go to this address (CORS is enabled on the backend).
VITE_SERVER_URL=http://localhost:8080

# Vite dev server (frontend only — must NOT clash with the backend port)
VITE_HOST=0.0.0.0
VITE_PORT=5173

# Electron dev mode page URL (leave empty to use http://localhost:VITE_PORT)
# Set to http://localhost:8080 when running the relay via `npm run dev` (it serves the UI itself)
ELECTRON_DEV_URL=

# Electron window
ELECTRON_WINDOW_WIDTH=1100
ELECTRON_WINDOW_HEIGHT=740
ELECTRON_WINDOW_MIN_WIDTH=840
ELECTRON_WINDOW_MIN_HEIGHT=540
